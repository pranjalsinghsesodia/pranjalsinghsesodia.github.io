---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/stories';
import { url } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);
const toc = headings.filter((h) => h.depth === 2);
const d = project.data;
const repoUrl = d.repo ? `https://github.com/${d.repo}` : '';
// portrait or very wide covers are shown whole on a blurred backdrop instead of being cropped to 16:9
const fitWhole = !!d.cover && Math.abs(d.cover.width / d.cover.height - 16 / 9) > 0.4;
const og = d.cover ? (await getImage({ src: d.cover, width: 1200, format: 'jpg' })).src : undefined;

// title block: item code from the project's order, e.g. PSS-001
const itemCode = `PSS-${String(d.order).padStart(3, '0')}`;
// figures may only use numbers that already appear in this project's own text
const sourceText = [
  project.body ?? '',
  d.title, d.summary, d.period, d.role, d.where, d.tools, d.status, d.peek, d.coverNote,
  ...d.story.flatMap((s) => [s.caption, s.sub, s.kicker, s.title, s.text]),
].filter(Boolean).join(' ');
for (const f of d.figures) {
  if (!sourceText.includes(f.value)) {
    throw new Error(`Figure "${f.value}" in projects/${project.id}.md doesn't appear in that project's text. Figures must reuse numbers from the text.`);
  }
}
---

<Base title={d.title} description={d.summary} image={og}>
  <article class="w cs" data-win={d.short}>
    <nav class="crumb"><a href={url('#work')}>← All work</a></nav>

    <header class="head">
      <div class="tblock">
        <div class="tb-row tb-strip">
          <div class="tb-cell"><span class="tb-k">Item</span><span class="tb-v tb-code">{itemCode}</span></div>
          <div class="tb-cell"><span class="tb-k">Year</span><span class="tb-v tb-code">{d.year}</span></div>
        </div>
        <div class="tb-row">
          <div class="tb-cell"><span class="tb-k">Title</span><h1 class="tb-v">{d.title}</h1></div>
        </div>
        <div class="tb-row">
          <div class="tb-cell"><span class="tb-k">Summary</span><p class="tb-v tb-sum">{d.summary}</p></div>
        </div>
        <div class="tb-row">
          {d.where && <div class="tb-cell"><span class="tb-k">Where</span><span class="tb-v">{d.where}</span></div>}
          <div class="tb-cell"><span class="tb-k">When</span><span class="tb-v">{d.period ?? d.year}</span></div>
        </div>
        {d.role && (
          <div class="tb-row">
            <div class="tb-cell"><span class="tb-k">Role</span><span class="tb-v">{d.role}</span></div>
          </div>
        )}
        {(d.supervisor || d.mentors.length > 0 || d.team) && (
          <div class="tb-row">
            {d.supervisor && <div class="tb-cell"><span class="tb-k">Supervisor</span><span class="tb-v">{d.supervisor}</span></div>}
            {d.mentors.length > 0 && (
              <div class="tb-cell"><span class="tb-k">{d.mentors.length > 1 ? 'Mentors' : 'Mentor'}</span><span class="tb-v">{d.mentors.join(', ')}</span></div>
            )}
            {d.team && <div class="tb-cell"><span class="tb-k">Team</span><span class="tb-v">{d.team}</span></div>}
          </div>
        )}
        <div class="tb-row">
          <div class="tb-cell"><span class="tb-k">Field</span><span class="tb-v">{d.field}</span></div>
          <div class="tb-cell tb-wide"><span class="tb-k">Tools</span><span class="tb-v">{d.tools}</span></div>
          <div class="tb-cell">
            <span class="tb-k">Status</span>
            <span class="tb-v"><span class:list={['tb-status', d.state]}>{d.status}</span></span>
          </div>
        </div>
        {d.figures.length > 0 && (
          <div class="tb-row tb-figs">
            {d.figures.map((f) => (
              <div class="tb-cell">
                <span class="tb-k">{f.label}</span>
                <span class="tb-v tb-num">{f.value}{f.unit && <small>{f.unit}</small>}</span>
              </div>
            ))}
          </div>
        )}
      </div>
      <div class="actions">
        <button class="play" type="button" data-reel={`p-${project.id}`}>▶ Play the story</button>
        {d.links.map((l) => <a class="out" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
        {repoUrl && <a class="out" href={repoUrl} target="_blank" rel="noopener">Source on GitHub ↗</a>}
      </div>
    </header>

    {
      d.cover && (
        <figure class="cover-fig">
          <div class:list={['cover-box', { whole: fitWhole }]}>
            {fitWhole && <Image src={d.cover} alt="" width={48} class="backdrop" />}
            <Image
              src={d.cover}
              alt={d.title}
              widths={[640, 1080, 1600, 2200].filter((w) => w <= d.cover.width).concat(d.cover.width < 640 ? [d.cover.width] : [])}
              sizes="(max-width: 1440px) 100vw, 1300px"
              class="cover"
              style={fitWhole ? `max-width:${d.cover.width}px;max-height:${d.cover.height}px` : undefined}
            />
          </div>
          {d.coverNote && <figcaption>{d.coverNote}</figcaption>}
        </figure>
      )
    }

    <div class="body-grid">
      <div class="prose body">
        <Content />
      </div>
      {
        toc.length > 1 && (
          <aside class="toc" aria-label="On this page">
            <p>On this page</p>
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
            <button class="play small" type="button" data-reel={`p-${project.id}`}>▶ Play the story</button>
          </aside>
        )
      }
    </div>

    <nav class="pager" aria-label="More projects">
      {prev ? <a href={url(`work/${prev.id}/`)}><span>Previous</span>{prev.data.title}</a> : <span></span>}
      {next ? <a class="nx" href={url(`work/${next.id}/`)}><span>Next</span>{next.data.title}</a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .cs {
    padding-block: 32px 40px;
  }
  .crumb {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
  }
  .crumb a:hover {
    color: var(--ink);
  }
  .head {
    padding-block: 28px 32px;
  }
  /* engineering title block: 1px rules between every cell, labels beside values, no fills or shadows */
  .tblock {
    border: 1px solid var(--ink);
  }
  .tb-row {
    display: flex;
    border-top: 1px solid var(--line);
    transition: background-color 70ms linear, color 70ms linear;
  }
  .tb-row:first-child {
    border-top: 0;
  }
  .tb-cell {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 10px 14px;
    border-left: 1px solid var(--line);
  }
  .tb-cell:first-child {
    border-left: 0;
  }
  .tb-wide {
    flex-grow: 2;
  }
  .tb-k {
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.6;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--steel);
    transition: color 70ms linear;
  }
  .tb-v {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .tb-strip {
    border-bottom: 1px solid var(--ink);
  }
  .tb-strip + .tb-row {
    border-top: 0;
  }
  .tb-code {
    color: var(--acc);
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }
  h1.tb-v {
    font-size: clamp(26px, 3.4vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.022em;
    font-weight: 500;
    text-wrap: balance;
  }
  .tb-sum {
    font-size: 17px;
    line-height: 1.5;
    max-width: 62ch;
  }
  .tb-num {
    color: var(--acc);
    white-space: nowrap;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .tb-num small {
    margin-left: 4px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tb-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border: 1px solid currentColor;
    border-radius: 0;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .tb-status.live {
    color: var(--acc);
    background: var(--accbg);
  }
  .tb-status.live::before {
    content: '';
    width: 6px;
    height: 6px;
    background: currentColor;
  }
  /* hover inverts the whole row */
  .tb-row:hover {
    background: var(--ink);
    color: var(--bg);
  }
  .tb-row:hover :is(.tb-k, .tb-status, .tb-code, .tb-num) {
    color: var(--bg);
    background: none;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
    margin-top: 28px;
    font-size: 14px;
  }
  .play {
    background: var(--ink);
    color: var(--bg);
    padding: 9px 16px;
    border-radius: 999px;
    font-weight: 500;
  }
  .play:hover {
    opacity: 0.88;
  }
  .out {
    border-bottom: 1px solid var(--line);
  }
  .out:hover {
    border-color: var(--acc);
  }
  .cover-fig {
    margin: 0 0 48px;
  }
  .cover-box {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
  }
  .cover-box {
    position: relative;
  }
  .cover-box.whole :global(.cover) {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .cover-box :global(.backdrop) {
    position: absolute;
    inset: -40px;
    width: calc(100% + 80px);
    height: calc(100% + 80px);
    max-width: none;
    object-fit: cover;
    filter: blur(30px) brightness(0.55);
  }
  .cover-fig figcaption {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--mute);
  }
  .body-grid {
    display: grid;
    grid-template-columns: minmax(0, 66ch) minmax(220px, 280px);
    justify-content: space-between;
    gap: 64px;
    margin-bottom: 64px;
  }
  .toc {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    align-self: start;
    padding-left: 20px;
    border-left: 1px solid var(--line);
    font-size: 14px;
  }
  .toc p {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mute);
    margin-bottom: 10px;
  }
  .toc li + li {
    margin-top: 8px;
  }
  .toc a {
    color: var(--mute);
  }
  .toc a:hover {
    color: var(--ink);
  }
  .play.small {
    margin-top: 22px;
    padding: 7px 14px;
    font-size: 13px;
  }
  @media (max-width: 1000px) {
    .body-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  .body :global(h2:first-child) {
    margin-top: 0;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-weight: 500;
  }
  .pager a:hover {
    color: var(--acc);
  }
  .pager span {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mute);
    font-weight: 400;
  }
  .pager .nx {
    text-align: right;
    align-items: flex-end;
  }
  @media (max-width: 760px) {
    .tb-row:not(.tb-strip):not(.tb-figs) {
      flex-direction: column;
    }
    .tb-row:not(.tb-strip):not(.tb-figs) > .tb-cell + .tb-cell {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .tb-figs {
      flex-wrap: wrap;
    }
    .tb-figs > .tb-cell {
      flex: 1 1 100%;
      border-left: 0;
      border-top: 1px solid var(--line);
      margin-top: -1px;
    }
    .tb-cell {
      grid-template-columns: 78px minmax(0, 1fr);
      gap: 10px;
      padding: 9px 12px;
    }
    .tb-strip .tb-cell {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .tb-sum {
      font-size: 15px;
    }
    .tb-num {
      font-size: 22px;
    }
  }
</style>
