---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photography from '../../components/Photography.astro';
import { SITE, url } from '../../lib/site';

const empty = (await getCollection('stories')).length + (await getCollection('films')).length === 0;
const insta = SITE.links.find((l) => l.label === 'Instagram')?.href;
---

<Base title="Photography & film" description="Photographs and films by Pranjal Singh Sesodia, month by month.">
  <div class="w">
    {
      empty ? (
        <section class="empty" data-win="Photography">
          <h1>Photography &amp; film</h1>
          <p>
            Nothing here yet.{' '}
            {insta ? <>In the meantime, my photography and video are on <a href={insta} target="_blank" rel="noopener">Instagram ↗</a></> : <a href={url('')}>Back to the index →</a>}
          </p>
        </section>
      ) : (
        <Photography mode="all" />
      )
    }
  </div>
</Base>

<style>
  .empty {
    padding-block: 96px;
    min-height: 50vh;
  }
  h1 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1;
    margin-bottom: 18px;
  }
  p {
    color: var(--mute);
  }
  a {
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
</style>
