---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, fmtDate, isVisible } from '../../lib/site';

const entries = (await getCollection('journal', isVisible)).sort((a, b) => +b.data.date - +a.data.date);
---

<Base title="Journal" description="Build logs and notes from Pranjal Singh Sesodia's engineering work.">
  <section class="w page">
    <h1>Journal</h1>
    <p class="lede">Build logs, mistakes and what I learned from them. New entries also go out by <a href={url('rss.xml')}>RSS</a>.</p>
    {
      entries.length ? (
        <ul class="list">
          {entries.map((e) => (
            <li>
              <time datetime={e.data.date.toISOString()}>{fmtDate(e.data.date)}</time>
              <a href={url(`journal/${e.id}/`)}>
                <h2>{e.data.title}{e.data.draft && <em class="draft">Draft</em>}</h2>
                <p>{e.data.summary}</p>
              </a>
              <span class="tags">{e.data.tags.join(' · ')}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">The first entries are being written.</p>
      )
    }
  </section>
</Base>

<style>
  .page {
    padding-block: 64px;
  }
  h1 {
    font-size: clamp(32px, 5vw, 52px);
    letter-spacing: -0.024em;
    font-weight: 500;
  }
  .lede {
    margin-top: 12px;
    color: var(--mute);
    max-width: 40em;
  }
  .lede a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .list {
    margin-top: 40px;
    border-top: 1px solid var(--ink);
  }
  .list li {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) 180px;
    gap: 20px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }
  time,
  .tags {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
    padding-top: 3px;
  }
  .tags {
    text-align: right;
  }
  h2 {
    font-size: 19px;
    font-weight: 500;
    line-height: 1.3;
  }
  a:hover h2 {
    color: var(--acc);
  }
  .list p,
  .empty {
    color: var(--mute);
    margin-top: 4px;
  }
  .empty {
    margin-top: 32px;
  }
  .draft {
    font-style: normal;
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--edge);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 1px 6px;
    margin-left: 8px;
    vertical-align: 3px;
  }
  @media (max-width: 760px) {
    .list li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .tags {
      text-align: left;
    }
  }
</style>
