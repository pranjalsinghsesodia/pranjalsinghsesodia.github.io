---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRings from '../components/ProjectRings.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import Photography from '../components/Photography.astro';
import { SITE, url, fmtShort, isVisible } from '../lib/site';
import me from '../assets/site/me.jpeg';

const journal = (await getCollection('journal', isVisible)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 6);
const og = (await getImage({ src: me, width: 1200, format: 'jpg' })).src;
const insta = SITE.links.find((l) => l.label === 'Instagram')?.href;
const hyperloop = (await getCollection('projects')).find((p) => p.id === 'hyperloop-gap');
// academic link row: Email / CV / Scholar / GitHub / LinkedIn
const LINKS = [
  { label: 'Email', href: `mailto:${SITE.emails[0]}` },
  { label: 'CV', href: url(SITE.cv) },
  ...SITE.links.filter((l) => l.href && l.label !== 'Instagram').map((l) => ({ ...l, label: l.label.replace('Google ', '') })),
];
// dated from the CV; months only where the CV gives them
const NEWS = [
  { when: 'Jun 2026', html: 'Joined <b>mPragati, IIT Delhi</b> as an R&amp;D intern with Prof. Dinesh Kalyanasundaram: a 6-DOF surgical assistance arm and implant mechanism reviews.' },
  { when: '2026', html: 'First-author review on levitation gap estimation for hyperloop pods published in <i>Next Research</i> (Elsevier).' },
  { when: '2026', html: 'Team Daedalus Racing placed <b>1st of 54</b> at the mBAJA 2026 Sustainability Event; I developed the catalytic converter.' },
  { when: 'Mar 2026', html: 'Started a tabletop subsonic wind tunnel on an NSUT CPVSK project grant.' },
  { when: 'Dec 2025', html: 'Joined <b>QuEST Lab, IIT Delhi</b> with Prof. Jay Dhariwal: multi-camera depth estimation for movement tracking.' },
];
const BIBTEX = `@article{sesodia2026levitation,
  author  = {Sesodia, Pranjal Singh and Dabass, V.},
  title   = {Robust Real-Time Levitation Gap Estimation for Hyperloop Pods},
  journal = {Next Research},
  year    = {2026},
  doi     = {10.1016/j.nexres.2026.102384}
}`;
const SKILLS = [
  { group: 'CAD & simulation', items: ['SolidWorks', 'Motion studies', 'ANSYS Mechanical', 'FEA', 'Multi-body dynamics', 'ANSYS Fluent', 'CFD'] },
  { group: 'Robotics', items: ['ROS 2', 'MuJoCo', 'MATLAB', 'Kinematics'] },
  { group: 'Vision', items: ['OpenCV', 'AlphaPose', 'OpenPose', 'Depth Anything', 'Stereo calibration'] },
  { group: 'Code & electronics', items: ['Python', 'C', 'ESP32', 'Arduino'] },
  { group: 'Fabrication', items: ['FDM printing', 'SLA printing', 'Rapid prototyping'] },
];
---

<Base image={og}>
  <div class="w">
    <section class="intro" data-win="Welcome">
      <div>
        <h1>Pranjal Singh Sesodia</h1>
        <p class="eyebrow">Mechanical engineering, NSUT Delhi '28 · {SITE.currently}</p>
        <p class="sub">
          I build and test robotic systems. At mPragati, IIT Delhi, I'm building a 6-DOF surgical assistance arm with
          Prof. Dinesh Kalyanasundaram; before that I worked on multi-camera depth estimation at QuEST Lab with Prof. Jay Dhariwal.
          I'm looking for a research internship in robotics.
        </p>
        <p class="ri"><span>Research interests</span> Simulation for robotics, thermal analysis and gripper dynamics.</p>
        <p class="elinks">
          {LINKS.map((l, i) => <>{i > 0 && <span aria-hidden="true">/</span>}<a href={l.href} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a></>)}
        </p>
      </div>
      <div class="me"><Image src={me} alt="Pranjal Singh Sesodia outside B Block at night" width={440} class="cover" loading="eager" /></div>
    </section>

    <section class="news" id="news" data-win="News" aria-labelledby="news-h">
      <div class="lbl"><span id="news-h">News</span></div>
      <ul>
        {NEWS.map((n) => <li><span class="when">{n.when}</span><p set:html={n.html} /></li>)}
      </ul>
    </section>

    <ProjectRings />
    <ProjectIndex />

    <section class="pubs" id="publications" data-win="Publication" aria-labelledby="pubs-h">
      <div class="lbl"><span id="pubs-h">Publication</span><span>First author</span></div>
      <article class="pub">
        {hyperloop?.data.cover && (
          <a class="pthumb" href={url('work/hyperloop-gap/')} tabindex="-1" aria-hidden="true">
            <Image src={hyperloop.data.cover} alt="" width={480} class="cover" />
          </a>
        )}
        <div>
          <a class="ptitle" href="https://doi.org/10.1016/j.nexres.2026.102384" target="_blank" rel="noopener">Robust real-time levitation gap estimation for hyperloop pods</a>
          <p class="authors"><b>Pranjal Singh Sesodia</b>, V. Dabass</p>
          <p class="venue"><i>Next Research</i> (Elsevier), 2026 · Review</p>
          <p class="plinks">
            <a href="https://doi.org/10.1016/j.nexres.2026.102384" target="_blank" rel="noopener">paper</a>
            <span aria-hidden="true">/</span>
            <a href={url('work/hyperloop-gap/')}>project page</a>
            <span aria-hidden="true">/</span>
            <button type="button" class="bib-btn" aria-expanded="false" aria-controls="bib">BibTeX</button>
          </p>
          <p class="takeaway">Compares inductive, optical, capacitive, Hall-effect and UWB-radar gap sensing, with Kalman-filter and sliding-mode observers, for maglev pods under thermal drift and EMI.</p>
          <pre id="bib" class="bib" hidden>{BIBTEX}</pre>
        </div>
      </article>
    </section>

    {journal.length > 0 && (
    <section class="jsec" id="journal" data-win="Journal" aria-labelledby="journal-h">
      <div class="lbl"><span id="journal-h">Journal</span><span><a href={url('journal/')}>All entries</a> · <a href={url('rss.xml')}>RSS</a></span></div>
      {
        journal.length ? (
          <ul class="jl">
            {journal.map((j) => (
              <li>
                <time datetime={j.data.date.toISOString()}>{fmtShort(j.data.date)}</time>
                <a href={url(`journal/${j.id}/`)}>
                  <b>{j.data.title}{j.data.draft && <em class="draft">Draft</em>}</b>
                  <p>{j.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">The first entries are being written.</p>
        )
      }
    </section>
    )}

    <Photography mode="home" />

    <section class="about" id="about" data-win="About" aria-labelledby="about-h">
      <div class="lbl"><h2 id="about-h">About</h2></div>
      <div>
        <p class="bio">
          I'm a third-year mechanical engineering student at NSUT Delhi. Over the past year I've worked in two labs at IIT Delhi:
          estimating 3D movement from webcams at QuEST Lab, and now building a surgical assistance arm and reviewing implant mechanisms
          at mPragati. Each project has followed the same loop: build it, test whether it does what it should, and find the assumption
          that doesn't hold. I'm looking for a research internship where I can keep doing that on harder problems.
        </p>
        <p class="also">
          Away from the bench I'm a photographer and videographer{insta ? <>: some of that work is on <a href={insta} target="_blank" rel="noopener">Instagram ↗</a></> : '.'}
        </p>
        <p class="int-h">Research interests</p>
        <dl class="interests">
          <div><dt>Simulation for robotics</dt><dd>Trying motions, contact and control in MuJoCo before they run on hardware.</dd></div>
          <div><dt>Thermal analysis</dt><dd>How heat changes the behaviour of actuators and grippers over time.</dd></div>
          <div><dt>Gripper dynamics</dt><dd>Contact, compliance and slip in grasping.</dd></div>
        </dl>
        <p class="now"><span>Now</span> An independent literature review on the thermal behaviour of robotic actuators and grippers.</p>
        <div class="skills">
          <p class="int-h">Skills</p>
          <dl>
            {SKILLS.map((g) => (
              <div>
                <dt>{g.group}</dt>
                <dd><ul class="tags">{g.items.map((t) => <li class="tag">{t}</li>)}</ul></dd>
              </div>
            ))}
          </dl>
        </div>
        <dl class="facts">
          <div><dt>Education</dt><dd>B.Tech Mechanical, NSUT Delhi, 2028<br />CGPA 8.07 / 10, rank 19 of 198</dd></div>
          <div><dt>Research</dt><dd>mPragati, IIT Delhi · Prof. Dinesh Kalyanasundaram<br />QuEST Lab, IIT Delhi · Prof. Jay Dhariwal</dd></div>
          <div><dt>Recognition</dt><dd>mBAJA 2026 Sustainability, 1st of 54<br />Provisional patent, India, 2022</dd></div>
        </dl>
        <p class="contact">
          <span>Write to me at</span>
          {SITE.emails.map((e, i) => <>{i > 0 && <span>or</span>}<span class="email">{e}</span></>)}
          <a href={url(SITE.cv)}>Download CV (PDF)</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  const bibBtn = document.querySelector<HTMLButtonElement>('.bib-btn');
  const bib = document.getElementById('bib');
  bibBtn?.addEventListener('click', () => {
    const open = bib!.hidden;
    bib!.hidden = !open;
    bibBtn.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(180px, 16vw, 240px);
    gap: clamp(28px, 5vw, 96px);
    align-items: start;
    padding-block: clamp(48px, 7vw, 104px) clamp(36px, 4vw, 56px);
  }
  h1 {
    font-size: clamp(32px, 3.6vw, 54px);
    line-height: 1.05;
    letter-spacing: -0.028em;
    font-weight: 500;
    text-wrap: balance;
  }
  .eyebrow {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--acc);
  }
  .sub {
    margin-top: 22px;
    max-width: 40em;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.55;
  }
  .ri {
    margin-top: 14px;
    max-width: 40em;
    font-size: 16px;
    color: var(--mute);
  }
  .ri span,
  .news .when {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--steel);
    margin-right: 10px;
  }
  .elinks {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 24px;
    font-size: 15px;
  }
  .elinks span {
    color: var(--line);
  }
  .elinks a,
  .plinks a,
  .bib-btn {
    color: var(--acc);
  }
  .elinks a:hover,
  .plinks a:hover,
  .bib-btn:hover,
  .ptitle:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .intro .me {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .news {
    margin-bottom: 56px;
  }
  .news li {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 14px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .news .when {
    padding-top: 3px;
    white-space: nowrap;
  }
  .news b {
    font-weight: 600;
  }

  .pubs {
    margin-top: 72px;
  }
  .pub {
    display: grid;
    grid-template-columns: clamp(140px, 14vw, 200px) minmax(0, 1fr);
    gap: 24px;
    padding-top: 20px;
    max-width: 62em;
  }
  .pthumb {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #fff;
  }
  .pthumb :global(img) {
    object-fit: contain !important;
  }
  .ptitle {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }
  .authors {
    margin-top: 4px;
    font-size: 15px;
    color: var(--mute);
  }
  .authors b {
    color: var(--ink);
    font-weight: 600;
  }
  .venue {
    font-size: 15px;
  }
  .plinks {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin-top: 6px;
    font-size: 14px;
  }
  .plinks span {
    color: var(--line);
  }
  .bib-btn {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .takeaway {
    margin-top: 10px;
    font-size: 14px;
    color: var(--mute);
    max-width: 60em;
  }
  .bib {
    margin-top: 12px;
    padding: 12px 14px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.6;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .jsec {
    padding-top: 64px;
    margin-top: 48px;
    border-top: 1px solid var(--line);
  }
  .jl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 56px;
  }
  .jl li {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 14px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }
  .jl time {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
  }
  .jl b {
    font-weight: 500;
    font-size: 16px;
    display: block;
  }
  .jl a:hover b {
    color: var(--acc);
  }
  .jl p,
  .empty {
    color: var(--mute);
    font-size: 14px;
  }
  .empty {
    padding-block: 18px;
  }
  .empty a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .draft {
    font-style: normal;
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--edge);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 1px 6px;
    margin-left: 8px;
    vertical-align: 2px;
  }

  .about {
    padding-block: 64px;
  }
  .about .lbl {
    margin-bottom: 24px;
  }
  .about .lbl h2 {
    font: inherit;
  }
  .bio {
    font-size: 19px;
    line-height: 1.45;
    letter-spacing: -0.01em;
    max-width: 34em;
  }
  .interests {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 28px;
    margin: 12px 0 0;
  }
  .interests dt {
    color: var(--acc);
    font-weight: 600;
    font-size: 15px;
    margin-bottom: 4px;
  }
  .interests dd {
    margin: 0;
    font-size: 14px;
    color: var(--mute);
  }
  .also {
    margin-top: 14px;
    font-size: 16px;
    color: var(--mute);
    max-width: 40em;
  }
  .also a {
    color: var(--acc);
    border-bottom: 1px solid color-mix(in srgb, var(--acc) 40%, transparent);
  }
  .also a:hover {
    border-color: var(--acc);
  }
  .int-h {
    margin-top: 32px;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--steel);
  }
  .now,
  .skills {
    margin-top: 6px;
  }
  .skills dl {
    margin: 12px 0 0;
    display: grid;
    gap: 10px;
  }
  .skills dl > div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
  }
  .skills dt {
    font-size: 13px;
    color: var(--steel);
  }
  .skills dd {
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
    color: var(--ink);
    background: var(--surface);
  }
  .tools {
    margin-top: 22px;
    font-size: 14px;
    color: var(--mute);
  }
  .now {
    color: var(--ink);
  }
  .now span,
  .tools span {
    color: var(--steel);
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-right: 10px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 32px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--steel);
    margin-bottom: 4px;
  }
  .facts dd {
    margin: 0;
    font-size: 14px;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: baseline;
    margin-top: 28px;
    font-size: 14px;
    color: var(--mute);
  }
  .contact .email {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    user-select: all;
    overflow-wrap: anywhere;
  }
  .contact a {
    color: var(--acc);
    border-bottom: 1px solid color-mix(in srgb, var(--acc) 40%, transparent);
  }
  .contact a:hover {
    border-color: var(--acc);
  }

  @media (max-width: 760px) {
    .intro {
      padding-block: 44px 32px;
    }
    .jl {
      grid-template-columns: 1fr;
    }
    .intro {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .intro .me {
      grid-row: 1;
      width: 132px;
    }
    .news li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .pub {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .pthumb {
      max-width: 240px;
    }
    .facts,
    .interests {
      grid-template-columns: 1fr;
    }
    .skills dl > div {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
