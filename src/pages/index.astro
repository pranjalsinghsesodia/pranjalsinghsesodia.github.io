---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRings from '../components/ProjectRings.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import Photography from '../components/Photography.astro';
import { SITE, url, fmtShort, isVisible } from '../lib/site';
import me from '../assets/site/me.jpg';

const journal = (await getCollection('journal', isVisible)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 6);
const og = (await getImage({ src: me, width: 1200, format: 'jpg' })).src;
const insta = SITE.links.find((l) => l.label === 'Instagram')?.href;
---

<Base image={og}>
  <div class="w">
    <section class="intro">
      <p class="eyebrow">{SITE.currently} · B.Tech Mechanical, NSUT Delhi '28</p>
      <h1>I build and test robotic systems.</h1>
      <p class="sub">Building a 6-DOF surgical assistance arm at mPragati, after multi-camera depth estimation at QuEST Lab. Recently drawn to simulation for robotics, thermal analysis and gripper dynamics.</p>
    </section>

    <ProjectRings />
    <ProjectIndex />

    <section class="pubs" id="publications" aria-labelledby="pubs-h">
      <div class="lbl"><span id="pubs-h">Publication</span><span>First author</span></div>
      <p class="cite">
        <b>Sesodia, P. S.</b>, &amp; Dabass, V. (2026). <a href="https://doi.org/10.1016/j.nexres.2026.102384" target="_blank" rel="noopener">Robust real-time levitation gap estimation for hyperloop pods</a>. <i>Next Research</i>, Elsevier.
        <span class="doi">doi:10.1016/j.nexres.2026.102384</span>
      </p>
    </section>

    {journal.length > 0 && (
    <section class="jsec" id="journal" aria-labelledby="journal-h">
      <div class="lbl"><span id="journal-h">Journal</span><span><a href={url('journal/')}>All entries</a> · <a href={url('rss.xml')}>RSS</a></span></div>
      {
        journal.length ? (
          <ul class="jl">
            {journal.map((j) => (
              <li>
                <time datetime={j.data.date.toISOString()}>{fmtShort(j.data.date)}</time>
                <a href={url(`journal/${j.id}/`)}>
                  <b>{j.data.title}{j.data.draft && <em class="draft">Draft</em>}</b>
                  <p>{j.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">The first entries are being written.</p>
        )
      }
    </section>
    )}

    <Photography mode="latest" />

    <section class="about" id="about" aria-labelledby="about-h">
      <div class="me"><Image src={me} alt="Pranjal Singh Sesodia" width={1440} class="cover" style="object-position: 56% 40%" /></div>
      <div>
        <h2 id="about-h" class="sr-only">About</h2>
        <p class="bio">
          I'm a third-year mechanical engineering student at NSUT Delhi. Over the past year I've worked in two labs at IIT Delhi:
          estimating 3D movement from webcams at QuEST Lab, and now building a surgical assistance arm and reviewing implant mechanisms
          at mPragati. Each project has followed the same loop: build it, test whether it does what it should, and find the assumption
          that doesn't hold. I'm looking for a research internship where I can keep doing that on harder problems.
        </p>
        <p class="also">
          Away from the bench I'm a photographer and videographer{insta ? <>: some of that work is on <a href={insta} target="_blank" rel="noopener">Instagram ↗</a></> : '.'}
        </p>
        <p class="int-h">Recently drawn to</p>
        <dl class="interests">
          <div><dt>Simulation for robotics</dt><dd>Trying motions, contact and control in MuJoCo before they run on hardware.</dd></div>
          <div><dt>Thermal analysis</dt><dd>How heat changes the behaviour of actuators and grippers over time.</dd></div>
          <div><dt>Gripper dynamics</dt><dd>Contact, compliance and slip in grasping.</dd></div>
        </dl>
        <p class="now"><span>Now</span> An independent literature review on the thermal behaviour of robotic actuators and grippers.</p>
        <p class="tools"><span>Tools</span> SolidWorks (parts, assemblies, motion) · ANSYS Mechanical (static structural, MBD) · ANSYS Fluent · Python (OpenCV) · OpenPose, AlphaPose · ROS 2 · MuJoCo · MATLAB · C · ESP32, Arduino · FDM/SLA printing</p>
        <dl class="facts">
          <div><dt>Education</dt><dd>B.Tech Mechanical, NSUT Delhi, 2028<br />CGPA 8.07 / 10, rank 19 of 198</dd></div>
          <div><dt>Research</dt><dd>mPragati, IIT Delhi · Prof. Dinesh Kalyanasundaram<br />QuEST Lab, IIT Delhi · Prof. Jay Dhariwal</dd></div>
          <div><dt>Recognition</dt><dd>mBAJA 2026 Sustainability, 1st of 54<br />Provisional patent, India, 2022</dd></div>
        </dl>
        <p class="contact">
          <span>Write to me at</span>
          {SITE.emails.map((e, i) => <>{i > 0 && <span>or</span>}<span class="email">{e}</span></>)}
          <a href={url(SITE.cv)}>Download CV (PDF)</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .intro {
    padding-block: clamp(56px, 8vw, 120px) clamp(40px, 5vw, 72px);
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
    margin-bottom: 20px;
  }
  h1 {
    font-size: clamp(30px, 3.4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.028em;
    font-weight: 500;
    text-wrap: balance;
  }
  .sub {
    margin-top: 16px;
    max-width: 38em;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.5;
    color: var(--mute);
  }

  .pubs {
    margin-top: 72px;
  }
  .cite {
    padding-top: 16px;
    font-size: 16px;
    line-height: 1.55;
    max-width: 62em;
  }
  .cite b {
    font-weight: 600;
  }
  .cite a {
    border-bottom: 1px solid var(--line);
  }
  .cite a:hover {
    border-color: var(--acc);
  }
  .doi {
    display: block;
    margin-top: 4px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
  }
  .jsec {
    padding-top: 64px;
    margin-top: 48px;
    border-top: 1px solid var(--line);
  }
  .jl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 56px;
  }
  .jl li {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 14px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }
  .jl time {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
  }
  .jl b {
    font-weight: 500;
    font-size: 16px;
    display: block;
  }
  .jl a:hover b {
    color: var(--acc);
  }
  .jl p,
  .empty {
    color: var(--mute);
    font-size: 14px;
  }
  .empty {
    padding-block: 18px;
  }
  .empty a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .draft {
    font-style: normal;
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--edge);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 1px 6px;
    margin-left: 8px;
    vertical-align: 2px;
  }

  .about {
    display: grid;
    grid-template-columns: clamp(220px, 20vw, 320px) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 72px);
    padding-block: 64px;
    border-top: 1px solid var(--line);
  }
  .me {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  .bio {
    font-size: 19px;
    line-height: 1.45;
    letter-spacing: -0.01em;
    max-width: 34em;
  }
  .interests {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 28px;
    margin: 12px 0 0;
  }
  .interests dt {
    font-weight: 600;
    font-size: 15px;
    margin-bottom: 4px;
  }
  .interests dd {
    margin: 0;
    font-size: 14px;
    color: var(--mute);
  }
  .also {
    margin-top: 14px;
    font-size: 16px;
    color: var(--mute);
    max-width: 40em;
  }
  .also a {
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .also a:hover {
    border-color: var(--acc);
  }
  .int-h {
    margin-top: 32px;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mute);
  }
  .now,
  .tools {
    margin-top: 22px;
    font-size: 14px;
    color: var(--mute);
  }
  .now {
    color: var(--ink);
  }
  .now span,
  .tools span {
    color: var(--mute);
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-right: 10px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 32px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mute);
    margin-bottom: 4px;
  }
  .facts dd {
    margin: 0;
    font-size: 14px;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: baseline;
    margin-top: 28px;
    font-size: 14px;
    color: var(--mute);
  }
  .contact .email {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    user-select: all;
    overflow-wrap: anywhere;
  }
  .contact a {
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .contact a:hover {
    border-color: var(--acc);
  }

  @media (max-width: 760px) {
    .intro {
      padding-block: 44px 32px;
    }
    .jl {
      grid-template-columns: 1fr;
    }
    .about {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .me {
      max-width: 220px;
    }
    .facts,
    .interests {
      grid-template-columns: 1fr;
    }
  }
</style>
