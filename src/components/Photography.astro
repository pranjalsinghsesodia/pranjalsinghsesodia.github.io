---
import { getCollection } from 'astro:content';
import ContactSheet from './ContactSheet.astro';
import Films from './Films.astro';
import { SITE } from '../lib/site';

interface Props {
  mode?: 'home' | 'all';
}
const { mode = 'home' } = Astro.props;
const hasStories = (await getCollection('stories')).length > 0;
const hasFilms = (await getCollection('films')).length > 0;
const insta = SITE.links.find((l) => l.label === 'Instagram')?.href;
---

{
  (hasStories || hasFilms) && (
    <section class="photo" id="photos" data-win="Contact sheet" aria-label="Photography and film">
      {hasStories ? (
        <ContactSheet mode={mode} />
      ) : (
        <h2 class="solo">Photography &amp; film</h2>
      )}
      <Films />
      {insta && (
        <p class="insta">
          More of my photography and video on <a href={insta} target="_blank" rel="noopener">Instagram ↗</a>
        </p>
      )}
    </section>
  )
}

<style>
  .photo {
    padding-bottom: 64px;
  }
  .solo {
    padding-top: 64px;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1;
  }
  .insta {
    margin-top: 22px;
    font-size: 14px;
    color: var(--mute);
  }
  .insta a {
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .insta a:hover {
    border-color: var(--acc);
  }
</style>
