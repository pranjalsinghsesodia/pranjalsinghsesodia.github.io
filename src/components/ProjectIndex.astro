---
import { Image, getImage } from 'astro:assets';
import { getProjects } from '../lib/stories';
import { url } from '../lib/site';

const projects = await getProjects();
const groups = [
  { key: 'robotics', label: 'Robotics' },
  { key: 'biomech', label: 'Biomechanics' },
  { key: 'fluids', label: 'Fluids' },
  { key: 'hardware', label: 'Hardware' },
  { key: 'research', label: 'Research' },
].map((g) => ({ ...g, n: projects.filter((p) => p.data.discipline === g.key).length }))
  .filter((g) => g.n > 0);

const rows = await Promise.all(
  projects.map(async (p) => ({
    p,
    peek: p.data.cover ? (await getImage({ src: p.data.cover, width: 560, format: 'webp' })).src : '',
  })),
);
---

<section class="idx" id="work" aria-labelledby="work-h">
  <div class="ihead">
    <h2 id="work-h">Selected work</h2>
    <p>Research, builds and mechanisms, newest first. Hover a field to filter.</p>
  </div>
  <div class="layout">
  <nav class="cats" aria-label="Filter projects by field">
    <button type="button" aria-pressed="true" data-f="all"><span>All work</span><sup>{projects.length}</sup></button>
    {groups.map((g) => <button type="button" aria-pressed="false" data-f={g.key}><span>{g.label}</span><sup>{g.n}</sup></button>)}
  </nav>

  <div class="tbl">
    <table>
      <thead>
        <tr><th>Year</th><th>Project</th><th class="c-f">Discipline</th><th class="c-t">Tools</th><th class="c-s">Status</th></tr>
      </thead>
      <tbody>
        {
          rows.map(({ p, peek }, i) => (
            <>
            {!p.data.featured && (i === 0 || rows[i - 1].p.data.featured) && (
              <tr class="sep" data-d="sep"><td colspan="5">Earlier and other work</td></tr>
            )}
            <tr data-d={p.data.discipline} data-peek={peek} data-title={p.data.title} data-text={p.data.peek ?? p.data.summary}>
              <td class="yr">{p.data.year}</td>
              <td class="pj">
                <a href={url(`work/${p.id}/`)}>{p.data.title}</a>
                {p.data.cover && (
                  <span class="thumb">
                    <Image src={p.data.cover} alt="" width={720} class="cover" />
                  </span>
                )}
              </td>
              <td class="c-f">{p.data.field}</td>
              <td class="c-t">{p.data.tools}</td>
              <td class="c-s">
                <span class:list={['pill', { live: p.data.state === 'live', win: p.data.state === 'win' }]}>{p.data.status}</span>
              </td>
            </tr>
            </>
          ))
        }
      </tbody>
    </table>
  </div>
  </div>
  <div class="peek" aria-hidden="true"></div>
</section>

<style>
  .idx {
    position: relative;
    padding-bottom: 12px;
  }
  .ihead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 32px;
    margin-bottom: 28px;
  }
  .ihead h2 {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .ihead p {
    color: var(--mute);
    font-size: 14px;
  }
  .layout {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .cats {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
  }
  .cats button {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    padding: 9px 0 9px 16px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 15px;
    color: var(--mute);
    transition: color 0.15s, border-color 0.15s, padding 0.2s;
  }
  .cats button:hover,
  .cats button:focus-visible {
    color: var(--ink);
  }
  .cats button[aria-pressed='true'] {
    color: var(--ink);
    border-left-color: var(--acc);
    padding-left: 20px;
  }
  .cats sup {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--mute);
  }
  tbody tr {
    animation: rowin 0.25s ease both;
  }
  @keyframes rowin {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  .tbl {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mute);
    text-align: left;
    padding: 0 16px 10px 0;
    border-bottom: 1px solid var(--ink);
  }
  th.c-s,
  td.c-s {
    text-align: right;
    padding-right: 0;
  }
  td {
    padding: 15px 16px 15px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  tbody tr {
    cursor: pointer;
    transition: background-color 0.15s;
  }
  tbody tr.sep {
    cursor: default;
    background: none !important;
  }
  tr.sep td {
    padding: 40px 0 10px;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mute);
    border-bottom: 1px solid var(--ink);
  }
  tbody tr:hover {
    background: var(--surface);
  }
  .yr {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--mute);
    white-space: nowrap;
    width: 84px;
    font-variant-numeric: tabular-nums;
  }
  .pj {
    font-weight: 500;
    font-size: 16px;
  }
  .pj a::after {
    content: ' →';
    opacity: 0;
    transition: opacity 0.15s;
  }
  tr:hover .pj a::after {
    opacity: 0.6;
  }
  .c-f,
  .c-t {
    color: var(--mute);
  }
  .thumb {
    display: none;
  }
  .peek {
    transition: opacity 0.08s linear;
    position: absolute;
    left: 0;
    top: 0;
    width: 280px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
    border: 1px solid var(--line);
    background: var(--surface);
    z-index: 3;
    box-shadow: 0 18px 40px -18px var(--shadow);
  }
  .peek.on {
    opacity: var(--o, 1);
  }
  .peek :global(.pimg) {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .peek :global(.ptxt) {
    padding: 12px 14px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--mute);
    line-height: 1.6;
  }
  .peek :global(.ptxt b) {
    display: block;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 4px;
  }

  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .cats {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px 18px;
      border-left: 0;
    }
    .cats button {
      padding: 4px 0;
      margin: 0;
      border-left: 0;
      border-bottom: 2px solid transparent;
    }
    .cats button[aria-pressed='true'] {
      padding-left: 0;
      border-bottom-color: var(--acc);
    }
  }
  @media (max-width: 760px) {
    thead {
      display: none;
    }
    .c-f,
    .c-t {
      display: none;
    }
    tbody tr {
      display: grid;
      grid-template-columns: 1fr auto;
      border-bottom: 1px solid var(--line);
      padding-block: 14px;
    }
    tbody td {
      border: 0;
      padding: 0;
    }
    .yr {
      grid-column: 1;
      grid-row: 1;
      width: auto;
    }
    td.c-s {
      grid-column: 2;
      grid-row: 1;
    }
    .pj {
      grid-column: 1 / -1;
      padding-top: 4px;
    }
    .thumb {
      display: block;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      margin-top: 10px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.idx').forEach((idx) => {
    const rows = [...idx.querySelectorAll<HTMLTableRowElement>('tbody tr')];
    const chips = [...idx.querySelectorAll<HTMLButtonElement>('.cats button')];
    const peek = idx.querySelector<HTMLElement>('.peek')!;
    const canHover = matchMedia('(hover: hover)').matches;
    const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    // hover, focus or click a field: it becomes active and stays active after the pointer leaves
    let active = 'all';
    const pick = (ch: HTMLButtonElement) => {
      if (ch.dataset.f === active) return;
      active = ch.dataset.f!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === ch)));
      rows.forEach((r) => (r.hidden = !(active === 'all' || r.dataset.d === active)));
    };
    chips.forEach((ch) => ['mouseenter', 'focus', 'click'].forEach((ev) => ch.addEventListener(ev, () => pick(ch))));

    rows.forEach((r) => {
      if (r.classList.contains('sep')) return;
      r.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        r.querySelector('a')?.click();
      });
      r.addEventListener('mouseenter', () => {
        if (!canHover || idx.clientWidth < 760) return;
        const { peek: src, title, text } = r.dataset;
        peek.innerHTML = src
          ? `<div class="pimg"><img class="cover" alt="" src="${src}"></div><div class="ptxt"><b>${esc(title)}</b>Open case study →</div>`
          : `<div class="ptxt"><b>${esc(title)}</b>${esc(text)}</div>`;
        peek.classList.add('on');
      });
      r.addEventListener('mouseleave', () => peek.classList.remove('on'));
      // fade with the cursor's height in the row: solid in the middle, gone at the top and bottom edges
      r.addEventListener('mousemove', (e) => {
        const b = r.getBoundingClientRect();
        const t = (e.clientY - b.top) / b.height;
        peek.style.setProperty('--o', Math.min(1, Math.sin(Math.PI * Math.min(1, Math.max(0, t))) * 1.6).toFixed(3));
      });
    });

    idx.addEventListener('mousemove', (e) => {
      const b = idx.getBoundingClientRect();
      let x = e.clientX - b.left + 24;
      const y = e.clientY - b.top - 60;
      if (x + 290 > b.width) x = e.clientX - b.left - 304;
      peek.style.transform = `translate(${x}px, ${y}px)`;
    });
  });
</script>
