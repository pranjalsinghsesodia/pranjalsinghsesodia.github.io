---
import { Image, getImage } from 'astro:assets';
import { getProjects } from '../lib/stories';
import { url } from '../lib/site';

const projects = await getProjects();
const groups = [
  { key: 'robotics', label: 'Robotics' },
  { key: 'biomech', label: 'Biomechanics' },
  { key: 'fluids', label: 'Fluids' },
  { key: 'hardware', label: 'Hardware' },
  { key: 'research', label: 'Research' },
].map((g) => ({ ...g, n: projects.filter((p) => p.data.discipline === g.key).length }))
  .filter((g) => g.n > 0);

const rows = await Promise.all(
  projects.map(async (p) => ({
    p,
    peek: p.data.cover ? (await getImage({ src: p.data.cover, width: 560, format: 'webp' })).src : '',
  })),
);
---

<section class="idx" id="work" aria-labelledby="work-h">
  <h2 id="work-h" class="sr-only">Work</h2>
  <div class="filters" role="group" aria-label="Filter projects">
    <button class="chip" type="button" aria-pressed="true" data-f="all">All<sup>{projects.length}</sup></button>
    {groups.map((g) => <button class="chip" type="button" aria-pressed="false" data-f={g.key}>{g.label}<sup>{g.n}</sup></button>)}
  </div>

  <div class="tbl">
    <table>
      <thead>
        <tr><th>Year</th><th>Project</th><th class="c-f">Discipline</th><th class="c-t">Tools</th><th class="c-s">Status</th></tr>
      </thead>
      <tbody>
        {
          rows.map(({ p, peek }, i) => (
            <>
            {!p.data.featured && (i === 0 || rows[i - 1].p.data.featured) && (
              <tr class="sep" data-d="sep"><td colspan="5">Earlier and other work</td></tr>
            )}
            <tr data-d={p.data.discipline} data-peek={peek} data-title={p.data.title} data-text={p.data.peek ?? p.data.summary}>
              <td class="yr">{p.data.year}</td>
              <td class="pj">
                <a href={url(`work/${p.id}/`)}>{p.data.title}</a>
                {p.data.cover && (
                  <span class="thumb">
                    <Image src={p.data.cover} alt="" width={720} class="cover" />
                  </span>
                )}
              </td>
              <td class="c-f">{p.data.field}</td>
              <td class="c-t">{p.data.tools}</td>
              <td class="c-s">
                <span class:list={['pill', { live: p.data.state === 'live', win: p.data.state === 'win' }]}>{p.data.status}</span>
              </td>
            </tr>
            </>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="peek" aria-hidden="true"></div>
</section>

<style>
  .idx {
    position: relative;
    padding-bottom: 12px;
  }
  .filters {
    margin-bottom: 22px;
  }
  .tbl {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mute);
    text-align: left;
    padding: 0 16px 10px 0;
    border-bottom: 1px solid var(--ink);
  }
  th.c-s,
  td.c-s {
    text-align: right;
    padding-right: 0;
  }
  td {
    padding: 15px 16px 15px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  tbody tr {
    cursor: pointer;
    transition: background-color 0.15s;
  }
  tbody tr.sep {
    cursor: default;
    background: none !important;
  }
  tr.sep td {
    padding: 40px 0 10px;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mute);
    border-bottom: 1px solid var(--ink);
  }
  tbody tr:hover {
    background: var(--surface);
  }
  .yr {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--mute);
    white-space: nowrap;
    width: 84px;
    font-variant-numeric: tabular-nums;
  }
  .pj {
    font-weight: 500;
    font-size: 16px;
  }
  .pj a::after {
    content: ' →';
    opacity: 0;
    transition: opacity 0.15s;
  }
  tr:hover .pj a::after {
    opacity: 0.6;
  }
  .c-f,
  .c-t {
    color: var(--mute);
  }
  .thumb {
    display: none;
  }
  .peek {
    position: absolute;
    left: 0;
    top: 0;
    width: 280px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
    border: 1px solid var(--line);
    background: var(--surface);
    z-index: 3;
    box-shadow: 0 18px 40px -18px var(--shadow);
  }
  .peek.on {
    opacity: 1;
  }
  .peek :global(.pimg) {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .peek :global(.ptxt) {
    padding: 12px 14px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--mute);
    line-height: 1.6;
  }
  .peek :global(.ptxt b) {
    display: block;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 4px;
  }

  @media (max-width: 760px) {
    thead {
      display: none;
    }
    .c-f,
    .c-t {
      display: none;
    }
    tbody tr {
      display: grid;
      grid-template-columns: 1fr auto;
      border-bottom: 1px solid var(--line);
      padding-block: 14px;
    }
    tbody td {
      border: 0;
      padding: 0;
    }
    .yr {
      grid-column: 1;
      grid-row: 1;
      width: auto;
    }
    td.c-s {
      grid-column: 2;
      grid-row: 1;
    }
    .pj {
      grid-column: 1 / -1;
      padding-top: 4px;
    }
    .thumb {
      display: block;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      margin-top: 10px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.idx').forEach((idx) => {
    const rows = [...idx.querySelectorAll<HTMLTableRowElement>('tbody tr')];
    const chips = [...idx.querySelectorAll<HTMLButtonElement>('.chip')];
    const peek = idx.querySelector<HTMLElement>('.peek')!;
    const canHover = matchMedia('(hover: hover)').matches;
    const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    chips.forEach((ch) =>
      ch.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === ch)));
        rows.forEach((r) => (r.hidden = !(ch.dataset.f === 'all' || r.dataset.d === ch.dataset.f)));
      }),
    );

    rows.forEach((r) => {
      if (r.classList.contains('sep')) return;
      r.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        r.querySelector('a')?.click();
      });
      r.addEventListener('mouseenter', () => {
        if (!canHover || idx.clientWidth < 760) return;
        const { peek: src, title, text } = r.dataset;
        peek.innerHTML = src
          ? `<div class="pimg"><img class="cover" alt="" src="${src}"></div><div class="ptxt"><b>${esc(title)}</b>Open case study →</div>`
          : `<div class="ptxt"><b>${esc(title)}</b>${esc(text)}</div>`;
        peek.classList.add('on');
      });
      r.addEventListener('mouseleave', () => peek.classList.remove('on'));
    });

    idx.addEventListener('mousemove', (e) => {
      const b = idx.getBoundingClientRect();
      let x = e.clientX - b.left + 24;
      const y = e.clientY - b.top - 60;
      if (x + 290 > b.width) x = e.clientX - b.left - 304;
      peek.style.transform = `translate(${x}px, ${y}px)`;
    });
  });
</script>
