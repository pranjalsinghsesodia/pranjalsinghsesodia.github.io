---
import { getReels } from '../lib/stories';
const reels = await getReels();
---

<script type="application/json" id="reels" set:html={JSON.stringify(reels)} />

<div class="story" id="story" role="dialog" aria-modal="true" aria-labelledby="s-title" hidden>
  <div class="card">
    <div class="media" id="s-media"></div>
    <div class="top">
      <div class="bars" id="s-bars"></div>
      <div class="meta">
        <b id="s-title"></b><span id="s-meta"></span>
        <button class="x" id="s-close" type="button" aria-label="Close story">×</button>
      </div>
    </div>
    <button class="nav prev" id="s-prev" type="button" aria-label="Previous"></button>
    <button class="nav next" id="s-next" type="button" aria-label="Next"></button>
    <div class="cap" id="s-cap" aria-live="polite"></div>
  </div>
</div>

<style>
  .story {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: calc(16px + env(safe-area-inset-top, 0px)) 16px calc(16px + env(safe-area-inset-bottom, 0px));
  }
  .card {
    position: relative;
    height: min(86vh, 780px);
    height: min(86dvh, 780px);
    aspect-ratio: 9 / 16;
    max-width: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 30px 80px -30px var(--shadow);
    color: #fff;
  }
  .media {
    position: absolute;
    inset: 0;
  }
  .media :global(.blur) {
    position: absolute;
    inset: -30px;
    width: calc(100% + 60px);
    height: calc(100% + 60px);
    max-width: none;
    object-fit: cover;
    filter: blur(24px) brightness(0.55);
  }
  .media :global(.front) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .media :global(.s-card) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: 76px 26px 96px;
    background: var(--film);
    color: #eee9e0;
  }
  .media :global(.s-card .k) {
    font: 500 11px/1.3 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--edge);
  }
  .media :global(.s-card b) {
    font-size: clamp(22px, 4vh, 30px);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .media :global(.s-card p) {
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.82;
  }
  .top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 3;
    padding: 10px 12px 28px;
    background: linear-gradient(#0009, transparent);
  }
  .bars {
    display: flex;
    gap: 4px;
  }
  .bars :global(i) {
    flex: 1;
    height: 2px;
    border-radius: 2px;
    background: #ffffff4d;
    overflow: hidden;
    display: block;
  }
  .bars :global(i b) {
    display: block;
    height: 100%;
    background: #fff;
    transform-origin: left;
    transform: scaleX(0);
  }
  .bars :global(i.done b) {
    transform: scaleX(1);
  }
  .bars :global(i.run b) {
    animation: fill var(--dur, 5s) linear forwards;
  }
  .story:global(.paused) .bars :global(i.run b) {
    animation-play-state: paused;
  }
  @keyframes fill {
    to {
      transform: scaleX(1);
    }
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: 13px;
  }
  .meta b {
    font-weight: 600;
  }
  .meta span {
    opacity: 0.75;
    font-size: 12px;
  }
  .x {
    margin-left: auto;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #0006;
    color: #fff;
    font-size: 20px;
    line-height: 1;
    text-align: center;
  }
  .nav {
    position: absolute;
    top: 64px;
    bottom: 80px;
    width: 40%;
    z-index: 2;
  }
  .prev {
    left: 0;
  }
  .next {
    right: 0;
  }
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    padding: 44px 16px 18px;
    background: linear-gradient(transparent, #000b);
    font-size: 14px;
  }
  .cap:empty {
    display: none;
  }
  .cap :global(small) {
    display: block;
    opacity: 0.72;
    font: 11px/1.5 var(--mono);
    margin-top: 2px;
  }
  .cap :global(a) {
    display: inline-block;
    margin-top: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-size: 13px;
    font-weight: 500;
  }
  @media (prefers-reduced-motion: reduce) {
    .bars :global(i.run b) {
      animation: fill var(--dur, 5s) linear forwards !important;
      animation-duration: var(--dur, 5s) !important;
    }
  }
</style>

<script>
  type Slide =
    | { type: 'img'; src: string; alt: string; caption?: string; sub?: string }
    | { type: 'video'; src: string; poster: string; alt: string; caption?: string; sub?: string }
    | { type: 'card'; kicker?: string; title?: string; text?: string };
  type Reel = { title: string; meta: string; href?: string; slides: Slide[] };

  const reels: Record<string, Reel> = JSON.parse(document.getElementById('reels')?.textContent || '{}');
  const el = document.getElementById('story')!;
  const media = document.getElementById('s-media')!;
  const bars = document.getElementById('s-bars')!;
  const cap = document.getElementById('s-cap')!;
  const title = document.getElementById('s-title')!;
  const meta = document.getElementById('s-meta')!;
  let reel: Reel | null = null;
  let i = 0;
  let opener: HTMLElement | null = null;

  const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function render() {
    if (!reel) return;
    const s = reel.slides[i];
    const last = i === reel.slides.length - 1;
    if (s.type === 'img') {
      media.innerHTML = `<img class="blur" alt="" src="${s.src}"><img class="front" alt="${esc(s.alt)}" src="${s.src}">`;
    } else if (s.type === 'video') {
      media.innerHTML = `<img class="blur" alt="" src="${s.poster}"><video class="front" src="${s.src}" poster="${s.poster}" autoplay muted playsinline aria-label="${esc(s.alt)}"></video>`;
    } else {
      media.innerHTML = `<div class="s-card">${s.kicker ? `<span class="k">${esc(s.kicker)}</span>` : ''}${s.title ? `<b>${esc(s.title)}</b>` : ''}${s.text ? `<p>${esc(s.text)}</p>` : ''}</div>`;
    }
    let c = s.type !== 'card' && s.caption ? esc(s.caption) + (s.sub ? `<small>${esc(s.sub)}</small>` : '') : '';
    if (last && reel.href) c += `${c ? '<br>' : ''}<a href="${reel.href}">Open the case study →</a>`;
    cap.innerHTML = c;
    [...bars.children].forEach((b, k) => (b.className = k < i ? 'done' : ''));
    const cur = bars.children[i] as HTMLElement;
    void cur.offsetWidth;
    cur.className = 'run';
    cur.style.setProperty('--dur', s.type === 'card' ? '6.5s' : '5s');
    const v = media.querySelector('video');
    if (v) {
      // a clip sets its own pace: the bar runs for the clip's length
      v.addEventListener('loadedmetadata', () => {
        if (isFinite(v.duration)) {
          cur.className = '';
          void cur.offsetWidth;
          cur.style.setProperty('--dur', `${v.duration}s`);
          cur.className = 'run';
        }
      });
    }
  }

  function open(key: string, from: HTMLElement, start = 0) {
    reel = reels[key];
    if (!reel) return;
    i = Math.min(Math.max(0, start), reel.slides.length - 1);
    opener = from;
    title.textContent = reel.title;
    meta.textContent = reel.meta;
    bars.innerHTML = reel.slides.map(() => '<i><b></b></i>').join('');
    el.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    render();
    (document.getElementById('s-close') as HTMLElement).focus();
  }

  function close() {
    el.hidden = true;
    el.classList.remove('paused');
    media.innerHTML = '';
    document.documentElement.style.overflow = '';
    opener?.focus();
  }

  function go(d: number) {
    if (!reel) return;
    const n = i + d;
    if (n < 0) i = 0;
    else if (n >= reel.slides.length) return close();
    else i = n;
    render();
  }

  bars.addEventListener('animationend', () => go(1));
  document.getElementById('s-next')!.addEventListener('click', () => go(1));
  document.getElementById('s-prev')!.addEventListener('click', () => go(-1));
  document.getElementById('s-close')!.addEventListener('click', close);
  el.addEventListener('click', (e) => {
    if (e.target === el) close();
  });
  el.addEventListener('pointerdown', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('.card') && !t.closest('.x, a')) el.classList.add('paused');
  });
  ['pointerup', 'pointercancel', 'pointerleave'].forEach((ev) => el.addEventListener(ev, () => el.classList.remove('paused')));
  document.addEventListener('keydown', (e) => {
    if (el.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') go(1);
    else if (e.key === 'ArrowLeft') go(-1);
    else if (e.key === 'Tab') {
      e.preventDefault();
      (document.getElementById('s-close') as HTMLElement).focus();
    }
  });
  document.addEventListener('visibilitychange', () => el.classList.toggle('paused', document.hidden));
  // pause/resume the clip together with the progress bar
  new MutationObserver(() => {
    const v = media.querySelector('video');
    if (v) el.classList.contains('paused') ? v.pause() : v.play().catch(() => {});
  }).observe(el, { attributes: true, attributeFilter: ['class'] });

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-reel]');
    if (!t) return;
    e.preventDefault();
    open(t.dataset.reel!, t, Number(t.dataset.start || 0));
  });
</script>
