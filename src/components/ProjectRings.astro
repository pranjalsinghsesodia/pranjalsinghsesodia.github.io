---
import { Image } from 'astro:assets';
import { getProjects } from '../lib/stories';
import { url } from '../lib/site';
const projects = (await getProjects()).filter((p) => p.data.featured);
---

<div class="rings-wrap">
  <ul class="rings" aria-label="Project stories">
    {
      projects.map((p) => (
        <li>
          <a href={url(`work/${p.id}/`)} data-reel={`p-${p.id}`} aria-label={`Play the ${p.data.short} story`}>
            <span class:list={['ring', { live: p.data.state === 'live' }]}>
              {p.data.cover ? (
                <Image src={p.data.cover} alt="" width={240} class="cover" />
              ) : (
                <span class="mono">{p.data.ring ?? p.data.short.slice(0, 5)}</span>
              )}
            </span>
            <span class="name">{p.data.short}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="note"><i></i>In progress. Each story is a 30-second tour of one project.</p>
</div>

<style>
  .rings-wrap {
    padding-bottom: 52px;
  }
  .rings {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding-block: 4px 6px;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }
  .rings::-webkit-scrollbar {
    display: none;
  }
  .rings a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 84px;
    font-size: 12px;
    text-align: center;
    line-height: 1.25;
  }
  .ring {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    padding: 3px;
    border: 1.5px solid var(--line);
    transition: transform 0.2s ease, border-color 0.2s;
  }
  .ring.live {
    border: 2px solid var(--acc);
  }
  .rings a:hover .ring {
    transform: scale(1.06);
    border-color: var(--ink);
  }
  .rings a:hover .ring.live {
    border-color: var(--acc);
  }
  .ring > :global(*) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
  }
  .mono {
    display: grid !important;
    place-items: center;
    background: var(--film);
    color: var(--edge);
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .note {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--mute);
  }
  .note i {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 2px solid var(--acc);
    margin-right: 6px;
    vertical-align: -1px;
  }
</style>
