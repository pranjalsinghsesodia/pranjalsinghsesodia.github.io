---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const films = (await getCollection('films')).sort((a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date);
const host = (u: string) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '').replace(/\.com$/, '');
  } catch {
    return '';
  }
};
---

{
  films.length > 0 && (
    <section class="films" aria-labelledby="films-h">
      <div class="lbl"><span id="films-h">Films</span><span>{films.length} {films.length === 1 ? 'film' : 'films'}</span></div>
      <ul class="row">
        {films.map((f) => (
          <li>
            <a href={f.data.link} target="_blank" rel="noopener" aria-label={`Watch ${f.data.title} on ${host(f.data.link)}`}>
              <span class="poster">
                <Image src={f.data.poster} alt="" widths={[480, 960]} sizes="(max-width: 760px) 80vw, 420px" class="cover" />
                <span class="play" aria-hidden="true">▶</span>
                {f.data.duration && <span class="dur">{f.data.duration}</span>}
              </span>
              <span class="meta">
                <b>{f.data.title}</b>
                <span>{[f.data.role, f.data.date.getUTCFullYear(), host(f.data.link)].filter(Boolean).join(' · ')} ↗</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .films {
    padding-top: 40px;
  }
  .row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(260px, 32%, 440px);
    justify-content: start;
    gap: 16px;
    overflow-x: auto;
    padding-block: 18px 6px;
    scroll-snap-type: x mandatory;
  }
  .row li {
    scroll-snap-align: start;
    min-width: 0;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .poster {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--film);
  }
  .poster :global(img) {
    transition: transform 0.4s ease, opacity 0.2s;
  }
  a:hover .poster :global(img) {
    transform: scale(1.03);
    opacity: 0.85;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #000a;
    color: #fff;
    font-size: 16px;
    padding-left: 3px;
  }
  .dur {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 2px 6px;
    border-radius: 4px;
    background: #000b;
    color: #fff;
    font: 11px var(--mono);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .meta b {
    font-weight: 500;
    font-size: 15px;
  }
  a:hover .meta b {
    color: var(--acc);
  }
  .meta span {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--mute);
  }
  @media (max-width: 760px) {
    .row {
      grid-auto-columns: 80%;
    }
  }
</style>
