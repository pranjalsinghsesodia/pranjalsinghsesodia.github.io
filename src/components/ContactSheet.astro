---
import { Image } from 'astro:assets';
import { getSets } from '../lib/stories';
import { url } from '../lib/site';

interface Props {
  /** "home": one sheet with set tabs. "all": every set as its own sheet (photos page). */
  mode?: 'home' | 'all';
}
const { mode = 'home' } = Astro.props;
const sets = await getSets();
const total = sets.reduce((n, s) => n + s.frames.length, 0);
const SEL = 'M18,62 C10,22 70,6 118,8 C170,10 196,34 192,64 C188,98 140,114 86,112 C40,110 12,92 14,58 C16,40 34,26 52,20';
// home: one sheet holding every frame; all: one sheet per set
const sheets = mode === 'home' ? [{ name: '', key: 'all', frames: sets.flatMap((s) => s.frames.map((f) => ({ ...f, set: s }))) }] : sets.map((s) => ({ ...s, frames: s.frames.map((f) => ({ ...f, set: s })) }));
---

<section class:list={['cs', mode]} aria-labelledby={`cs-h-${mode}`}>
  <div class="head">
    <h2 id={`cs-h-${mode}`}>Contact sheet</h2>
    <p>
      Outtakes from the lab and side builds that don't get a write-up. The circled frame is my pick. Tap any frame to play its
      set.
    </p>
  </div>

  {
    total === 0 ? (
      <p class="empty">The first frames are on their way.</p>
    ) : (
      sheets.map((sheet) => (
        <div class="roll" data-set={sheet.key}>
          {mode === 'home' ? (
            <div class="bar">
              <div class="filters" role="group" aria-label="Show one set">
                <button class="chip" type="button" aria-pressed="true" data-f="all">All<sup>{total}</sup></button>
                {sets.map((s) => (
                  <button class="chip" type="button" aria-pressed="false" data-f={s.name}>{s.name}<sup>{s.frames.length}</sup></button>
                ))}
              </div>
            </div>
          ) : (
            <h3 class="set-h">{sheet.name}<span>{sheet.frames.length} frames</span></h3>
          )}
          <ul class="sheet">
            {sheet.frames.map(({ entry, no, start, set }) => (
              <li data-h={set.name}>
                <button
                  type="button"
                  data-reel={set.key}
                  data-start={start}
                  aria-label={`${set.name}, frame ${no}${entry.data.caption ? ': ' + entry.data.caption : ''}`}
                >
                  <span class="pic">
                    <Image src={entry.data.image} alt="" widths={[360, 720]} sizes="(max-width: 760px) 45vw, 340px" class="cover" />
                  </span>
                  <span class="edge"><span>{String(no).padStart(2, '0')}</span><span>{set.name}</span></span>
                  {entry.data.video && <span class="clip" aria-hidden="true">▶</span>}
                  {entry.data.pick && (
                    <svg class="sel" viewBox="0 0 200 120" preserveAspectRatio="none" aria-hidden="true"><path d={SEL} /></svg>
                  )}
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))
    )
  }
  {mode === 'home' && sets.length > 1 && <p class="more"><a href={url('photos/')}>Every set →</a></p>}
</section>

<style>
  .cs {
    padding-block: 64px;
  }
  .roll + .roll {
    margin-top: 48px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 12px 32px;
    margin-bottom: 24px;
  }
  h2 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .head p,
  .empty {
    color: var(--mute);
    max-width: 30em;
    font-size: 15px;
  }
  .set-h {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 14px;
    font-size: 20px;
    font-weight: 500;
  }
  .set-h span {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
    color: var(--mute);
  }
  .bar {
    margin-bottom: 16px;
  }
  .sheet {
    background: var(--film);
    padding: 18px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 12px;
  }
  .sheet button {
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
    width: 100%;
  }
  .pic {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    transition: opacity 0.2s;
  }
  .sheet button:hover .pic {
    opacity: 0.82;
  }
  .edge {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--edge);
  }
  .clip {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #000a;
    color: #fff;
    font-size: 10px;
    padding-left: 2px;
  }
  .sel {
    position: absolute;
    inset: -10px -12px 6px -12px;
    pointer-events: none;
    overflow: visible;
  }
  .sel path {
    fill: none;
    stroke: var(--grease);
    stroke-width: 3;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .more {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
  }
  .more a:hover {
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 12px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.cs .roll').forEach((roll) => {
    const chips = [...roll.querySelectorAll<HTMLButtonElement>('.chip')];
    const frames = [...roll.querySelectorAll<HTMLElement>('.sheet li')];
    chips.forEach((ch) =>
      ch.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === ch)));
        frames.forEach((f) => (f.hidden = !(ch.dataset.f === 'all' || f.dataset.h === ch.dataset.f)));
      }),
    );
  });
</script>
