---
import '../styles/global.css';
import '../styles/skins.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StoryViewer from '../components/StoryViewer.astro';
import { SITE, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0e0f10" id="theme-color" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Journal" href={url('rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@1,6..96,400&family=Geist+Mono:wght@400;500&family=Schibsted+Grotesk:wght@400..700&display=swap"
    />
    <!-- Dark by default; a saved choice wins. Runs before paint so the page never flashes. -->
    <script is:inline>
      (function () {
        var t = 'dark';
        try {
          if (localStorage.getItem('theme') === 'light') t = 'light';
        } catch (e) {}
        document.documentElement.dataset.theme = t;
        // design style: studio (default), bevel or prints; its fonts load only when it's in use
        var k = 'studio';
        try {
          k = localStorage.getItem('skin') || 'studio';
        } catch (e) {}
        var F = {
          bevel: 'https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..600&display=swap',
          prints: 'https://fonts.googleapis.com/css2?family=Architects+Daughter&display=swap',
        };
        window.__skinFonts = F;
        if (F[k]) {
          document.documentElement.dataset.skin = k;
          var l = document.createElement('link');
          l.rel = 'stylesheet';
          l.href = F[k];
          l.id = 'skin-font-' + k;
          document.head.appendChild(l);
        }
        var m = document.getElementById('theme-color');
        if (m) m.setAttribute('content', t === 'light' ? '#ecedea' : '#0e0f10');
      })();
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <StoryViewer />

    <script>
      // theme toggle
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      const label = btn?.querySelector('.theme-label');
      const meta = document.getElementById('theme-color');
      const sync = () => {
        const dark = root.dataset.theme !== 'light';
        btn?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        if (label) label.textContent = dark ? 'Light' : 'Dark';
        meta?.setAttribute('content', dark ? '#0e0f10' : '#ecedea');
      };
      sync();
      btn?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch (e) {}
        sync();
      });

      // design style switcher: one click moves to the next style
      const SKINS = ['studio', 'bevel', 'prints'];
      const NAMES: Record<string, string> = { studio: 'Studio', bevel: 'Bevel', prints: 'Prints' };
      const skinBtn = document.getElementById('skin-toggle');
      const skinLabel = skinBtn?.querySelector('.skin-label');
      const syncSkin = () => {
        const k = root.dataset.skin || 'studio';
        const next = SKINS[(SKINS.indexOf(k) + 1) % SKINS.length];
        if (skinLabel) skinLabel.textContent = NAMES[k];
        skinBtn?.setAttribute('aria-label', `Style: ${NAMES[k]}. Switch to ${NAMES[next]}`);
        skinBtn?.setAttribute('title', `Switch to ${NAMES[next]} style`);
      };
      syncSkin();
      skinBtn?.addEventListener('click', () => {
        const k = root.dataset.skin || 'studio';
        const next = SKINS[(SKINS.indexOf(k) + 1) % SKINS.length];
        const fonts = (window as unknown as { __skinFonts: Record<string, string> }).__skinFonts || {};
        if (fonts[next] && !document.getElementById('skin-font-' + next)) {
          const l = document.createElement('link');
          l.rel = 'stylesheet';
          l.href = fonts[next];
          l.id = 'skin-font-' + next;
          document.head.appendChild(l);
        }
        if (next === 'studio') delete root.dataset.skin;
        else root.dataset.skin = next;
        try {
          localStorage.setItem('skin', next);
        } catch (e) {}
        syncSkin();
      });

      // phone menu
      const menu = document.getElementById('menu-toggle');
      const links = document.getElementById('nav-links');
      menu?.addEventListener('click', () => {
        const open = links?.classList.toggle('open') ?? false;
        menu.setAttribute('aria-expanded', String(open));
        menu.textContent = open ? 'Close' : 'Menu';
      });
      links?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a') && links.classList.contains('open')) menu?.click();
      });

      // New Delhi clock
      const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata' });
      const tick = () => document.querySelectorAll('.clock').forEach((c) => (c.textContent = fmt.format(new Date())));
      tick();
      setInterval(tick, 15000);
    </script>
  </body>
</html>
